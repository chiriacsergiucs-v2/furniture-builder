{
  "name": "furniture-builder",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "catalog:docs": "UPDATE_CATALOG_DOC=1 vitest run tests/catalog.test.ts",
    "catalog:snapshots": "WRITE_SNAPSHOTS=1 vitest run tests/snapshots.test.ts",
    "docs:check": "python3 -I scripts/check-docs.py && python3 -I -m unittest discover -s scripts -p 'test_*.py' -q",
    "gaps": "python3 -I scripts/gaps.py"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "0.9.16",
    "xatlas-web": "0.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "workbox-window": "7.4.1"
  }
}
