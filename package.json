{
  "name": "furniture-builder",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:ci": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "browser:capture": "node tools/capture/capture.mjs",
    "browser:capture-flows": "node tools/capture/flows.mjs",
    "browser:capture-flows3": "node tools/capture/flows3.mjs",
    "browser:contrast": "node tools/capture/contrast.mjs",
    "next-id": "python3 -I scripts/id_collision_hook.py --next",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --cache --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "test": "vitest run",
    "catalog:docs": "UPDATE_CATALOG_DOC=1 vitest run tests/catalog.test.ts",
    "catalog:snapshots": "WRITE_SNAPSHOTS=1 vitest run tests/snapshots.test.ts",
    "dups": "python3 -I scripts/dups.py",
    "docs:check": "python3 -I scripts/check-docs.py && python3 -I -m unittest discover -s scripts -p 'test_*.py' -q",
    "gaps": "python3 -I scripts/gaps.py",
    "regress": "node tools/regress.mjs",
    "sync:pending": "node scripts/sync-pending.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@fontsource/fira-sans-condensed": "5.3.0",
    "@furniture-builder/i18n": "workspace:*",
    "@furniture-builder/nesting": "workspace:*",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "2.119.0",
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "three-gpu-pathtracer": "0.0.28",
    "three-mesh-bvh": "0.9.18",
    "xatlas-web": "0.1.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "workbox-window": "7.4.1"
  }
}
